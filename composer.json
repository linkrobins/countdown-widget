{
    "name": "linkrobins/countdown-widget",
    "description": "Countdown widget for fof/forum-widgets-core",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "widget",
        "countdown",
        "timer",
        "forum-widgets"
    ],
    "support": {
        "issues": "https://github.com/linkrobins/countdown-widget/issues",
        "source": "https://github.com/linkrobins/countdown-widget"
    },
    "homepage": "https://linkrobins.com/extensions/countdown-widget",
    "license": "MIT",
    "authors": [
        {
            "name": "Link Robins",
            "email": "karl@linkrobins.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "fof/forum-widgets-core": "^2.0.0-beta.3"
    },
    "extra": {
        "flarum-extension": {
            "title": "Link Robins Countdown Widget",
            "category": "forum-widget",
            "icon": {
                "name": "fas fa-hourglass-half",
                "color": "#07adcc",
                "backgroundColor": "#1a2535"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
